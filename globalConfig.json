{
    "pages": {
        "configuration": {
            "tabs": [
                {
                    "name": "ai_configuration",
                    "title": "AI Configuration",
                    "entity": [
                        {
                            "type": "singleSelect",
                            "label": "LLM Backend",
                            "field": "backend",
                            "help": "Direct calls the LLM API below with your own key. Splunk AI Toolkit borrows an LLM connection configured in the AI Toolkit app instead, so there is no second API key to manage, and on Splunk Cloud it can reach Splunk Hosted Models. The Toolkit route is noticeably slower because each call is dispatched as a search.",
                            "required": false,
                            "defaultValue": "direct",
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "direct",
                                        "label": "Direct (API key)"
                                    },
                                    {
                                        "value": "splunk_ai_toolkit",
                                        "label": "Splunk AI Toolkit"
                                    }
                                ]
                            },
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Backend must be either 'direct' or 'splunk_ai_toolkit'",
                                    "pattern": "^(direct|splunk_ai_toolkit)$"
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "AI Toolkit connection",
                            "field": "toolkit_connection",
                            "help": "Only used when the backend is Splunk AI Toolkit. The list shows the connections shared with you; connections are per-user, so one that is not shared with you will not appear and cannot be used. Leave blank to use your default connection. Any name can still be typed.",
                            "required": false,
                            "options": {
                                "endpointUrl": "cim-plicity/toolkit_connections",
                                "labelField": "label",
                                "createSearchChoice": true
                            },
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of connection name should be between 0 and 255",
                                    "minLength": 0,
                                    "maxLength": 255
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "LLM API Endpoint",
                            "field": "api_endpoint",
                            "help": "e.g. https://openrouter.ai/api/v1/chat/completions Required when the backend is Direct.",
                            "required": false,
                            "encrypted": false,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of URL should be between 1 and 255",
                                    "minLength": 1,
                                    "maxLength": 255
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "API key",
                            "field": "api_key",
                            "help": "API key Required when the backend is Direct.",
                            "required": false,
                            "encrypted": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of API key should be between 1 and 255",
                                    "minLength": 1,
                                    "maxLength": 255
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Model",
                            "field": "model",
                            "help": "Model ID. The list loads from the provider behind the LLM API Endpoint (OpenRouter, OpenAI, Anthropic or any OpenAI-compatible API). Type to search, or enter any model ID not in the list. Required when the backend is Direct.",
                            "required": false,
                            "options": {
                                "endpointUrl": "cim-plicity/ai_model_choices",
                                "labelField": "label",
                                "createSearchChoice": true,
                                "dependencies": [
                                    "api_endpoint"
                                ]
                            },
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of model ID should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "multipleSelect",
                            "label": "PII Detectors",
                            "field": "pii_detectors",
                            "help": "Select detectors to enable for PII scanning",
                            "required": false,
                            "options": {
                                "delimiter": "|",
                                "items": [
                                    {
                                        "value": "CredentialDetector",
                                        "label": "Credential"
                                    },
                                    {
                                        "value": "CreditCardDetector",
                                        "label": "Credit Card"
                                    },
                                    {
                                        "value": "DriversLicenceDetector",
                                        "label": "Driver's Licence"
                                    },
                                    {
                                        "value": "EmailDetector",
                                        "label": "Email"
                                    },
                                    {
                                        "value": "en_GB.NationalInsuranceNumberDetector",
                                        "label": "UK National Insurance Number"
                                    },
                                    {
                                        "value": "PhoneDetector",
                                        "label": "Phone"
                                    },
                                    {
                                        "value": "PostalCodeDetector",
                                        "label": "Postal Code"
                                    },
                                    {
                                        "value": "en_US.SocialSecurityNumberDetector",
                                        "label": "US Social Security Number"
                                    },
                                    {
                                        "value": "en_GB.TaxReferenceNumberDetector",
                                        "label": "UK Tax Reference Number"
                                    },
                                    {
                                        "value": "TwitterDetector",
                                        "label": "Twitter Handle"
                                    },
                                    {
                                        "value": "UrlDetector",
                                        "label": "URL"
                                    },
                                    {
                                        "value": "VehicleLicencePlateDetector",
                                        "label": "Vehicle Licence Plate"
                                    },
                                    {
                                        "value": "DateOfBirthDetector",
                                        "label": "Date of Birth"
                                    },
                                    {
                                        "value": "SkypeDetector",
                                        "label": "Skype"
                                    },
                                    {
                                        "value": "TaggedEvaluationFilthDetector",
                                        "label": "Tagged Evaluation Filth"
                                    },
                                    {
                                        "value": "TextBlobNameDetector",
                                        "label": "TextBlob Name"
                                    },
                                    {
                                        "value": "UserSuppliedFilthDetector",
                                        "label": "User Supplied Filth"
                                    },
                                    {
                                        "value": "IpAddressDetector",
                                        "label": "IP Address"
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "prompts",
                    "title": "Prompts",
                    "entity": [
                        {
                            "type": "textarea",
                            "label": "Field extraction guidance",
                            "field": "ai_detection_guidance",
                            "help": "Instructions sent to the model for the ai_detection call. Leave blank to use the shipped prompt. The JSON output contract is appended automatically and is not editable, because every parser downstream depends on that exact shape. Placeholders: {sample_data} is required. {description_block} is optional and carries the user's own context note. Any other brace, including example JSON you paste, is left alone. A value missing a required placeholder is ignored in favour of the shipped prompt, and the reason is logged to cim-plicity.log.",
                            "required": false,
                            "encrypted": false,
                            "defaultValue": "",
                            "options": {
                                "rowsMin": 12,
                                "rowsMax": 30
                            },
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Guidance must be 8000 characters or fewer",
                                    "minLength": 0,
                                    "maxLength": 8000
                                }
                            ]
                        },
                        {
                            "type": "textarea",
                            "label": "CIM mapping guidance",
                            "field": "cim_mapping_guidance",
                            "help": "Instructions sent to the model for the cim_mapping call. Leave blank to use the shipped prompt. The JSON output contract is appended automatically and is not editable, because every parser downstream depends on that exact shape. Placeholders: {cim_model}, {available_cim_fields} and {extracted_fields} are all required. Any other brace, including example JSON you paste, is left alone. A value missing a required placeholder is ignored in favour of the shipped prompt, and the reason is logged to cim-plicity.log.",
                            "required": false,
                            "encrypted": false,
                            "defaultValue": "",
                            "options": {
                                "rowsMin": 12,
                                "rowsMax": 30
                            },
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Guidance must be 8000 characters or fewer",
                                    "minLength": 0,
                                    "maxLength": 8000
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "loggingTab"
                }
            ],
            "title": "Configuration",
            "description": "Set up your add-on"
        }
    },
    "meta": {
        "name": "cim-plicity",
        "restRoot": "cim-plicity",
        "navColor": "#1e1633",
        "version": "1.0.12+6d83efa",
        "displayName": "CIMPlicity AI",
        "schemaVersion": "0.0.10",
        "supportedThemes": [
            "light",
            "dark"
        ],
        "os-dependentLibraries": [
            {
                "name": "regex",
                "version": "2024.11.6",
                "dependencies": true,
                "platform": "manylinux_2_17_x86_64",
                "python_version": "3.9",
                "os": "linux",
                "target": "3rdparty/linux_lib_py39"
            },
            {
                "name": "numpy",
                "version": "1.26.4",
                "dependencies": true,
                "platform": "manylinux_2_17_x86_64",
                "python_version": "3.9",
                "os": "linux",
                "target": "3rdparty/linux_lib_py39"
            }
        ]
    }
}
