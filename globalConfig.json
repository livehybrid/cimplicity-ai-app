{
    "pages": {
        "configuration": {
            "tabs": [
                {
                    "name": "ai_configuration",
                    "title": "AI Configuration",
                    "entity": [
                        {
                            "type": "text",
                            "label": "LLM API Endpoint",
                            "field": "api_endpoint",
                            "help": "e.g. https://openrouter.ai/api/v1/chat/completions",
                            "required": true,
                            "encrypted": false,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of URL should be between 1 and 255",
                                    "minLength": 1,
                                    "maxLength": 255
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "API key",
                            "field": "api_key",
                            "help": "API key",
                            "required": true,
                            "encrypted": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of API key should be between 1 and 255",
                                    "minLength": 1,
                                    "maxLength": 255
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Model",
                            "field": "model",
                            "help": "Model ID. The list loads from the provider behind the LLM API Endpoint (OpenRouter, OpenAI, Anthropic or any OpenAI-compatible API). Type to search, or enter any model ID not in the list.",
                            "required": true,
                            "options": {
                                "endpointUrl": "cim-plicity/ai_model_choices",
                                "labelField": "label",
                                "createSearchChoice": true,
                                "dependencies": [
                                    "api_endpoint"
                                ]
                            },
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of model ID should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "multipleSelect",
